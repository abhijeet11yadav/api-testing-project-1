    {
      "name": "test 3 adding obj 409  dublicate resource creation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "",
              "    pm.test(\"Duplicate resource allowed - new object created with different ID\", function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    });",
              "",
              "} else if (pm.response.code === 409) {",
              "",
              "    pm.test(\"Duplicate resource blocked correctly with 409 Conflict\", function () {",
              "        pm.response.to.have.status(409);",
              "    });",
              "",
              "} else {",
              "",
              "    pm.test(\"Unexpected response received\", function () {",
              "        throw new Error(\"Unexpected status code: \" + pm.response.code);",
              "    });",
              "",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
